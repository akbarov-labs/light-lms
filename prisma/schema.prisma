// lms-light data model. See HANDOFF.md §6.
// Money = integer UZS. Balance is always SUM(LedgerEntry.amount), never a stored total.

// Prisma 7: a TypeScript client generated into src/generated/prisma (not committed; `npm install`
// runs `prisma generate`). No native query engine: the client talks to Postgres via @prisma/adapter-pg.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// the connection URL is read in prisma.config.ts (CLI) and src/lib/db.ts (client)
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  ADMIN
  TEACHER
}

enum PricingType {
  SUBSCRIPTION
  PACKAGE
}

enum Renewal {
  CALENDAR
  GROUP_START
  STUDENT_START
}

enum GroupStatus {
  PLANNED
  ACTIVE
  FINISHED
  ARCHIVED
}

enum LessonStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  TRIAL
  ACTIVE
  FROZEN
  LEFT
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum LedgerType {
  CHARGE
  CREDIT
  PAYMENT
  REFUND
  REVERSAL
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  PAYME
  CLICK
  UZUM
  SYSTEM
  PAYNET
}

enum SalaryModel {
  PERCENT_EARNED
  FIXED
  PER_LESSON
  BASE_PLUS_PERCENT
}

enum PayslipStatus {
  DRAFT
  LOCKED
  PAID
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_BOOKED
  TRIAL_DONE
  ENROLLED
  LOST
}

enum LinkKind {
  GUARDIAN
  STUDENT
  STAFF
}

enum Plan {
  FREE
  START
  GROWTH
  PRO
}

enum NotificationChannel {
  TELEGRAM
  SMS
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Who made a change: a signed-in staff user, the public lead form, the AI agent, or a background job.
enum ActorKind {
  USER
  PUBLIC
  AGENT
  SYSTEM
}

model Center {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  currency        String    @default("UZS")
  timezone        String    @default("Asia/Tashkent")
  locale          String    @default("uz")
  accentColor     String    @default("#2563eb")
  logoUrl         String?
  phone           String?
  settings        Json      @default("{}")
  paymeMerchantId String?
  /// unique: the Payme key identifies the center on /api/payme
  paymeKey        String?   @unique
  paymeTestMode   Boolean   @default(true)
  /// Click SHOP-API (v2). service_id identifies the center on /api/click/*; the secret key signs every request.
  clickServiceId  String?   @unique
  clickMerchantId String?
  clickSecretKey  String?
  /// Uzum Bank Merchant API (v2). serviceId identifies the center on /api/uzum/*; Basic auth login + password.
  uzumServiceId   String?   @unique
  uzumLogin       String?
  uzumPassword    String?
  /// SMS gateway (v2): the center\'s own Eskiz.uz account (email + password) and sender name ("4546" = Eskiz default).
  smsLogin        String?
  smsPassword     String?
  smsFrom         String?
  receiptSeq      Int       @default(0)
  groupSeq        Int       @default(0)
  /// last certificate number issued this year is derived from this counter (v2)
  certSeq         Int       @default(0)
  /// SaaS plan: caps active students (see src/lib/plans.ts). No billing integration yet.
  plan            Plan      @default(FREE)
  /// Set by a platform admin: staff can't sign in, public forms are closed. Data is kept.
  disabledAt      DateTime?
  disabledReason  String?
  /// Set by a platform admin: this center may create its own Telegram bot (managed bots, pilot allow-list)
  ownBotAllowed   Boolean   @default(false)
  /// Setup wizard progress: { step, done: { branch, course, group, teacher }, courseId?, groupId?, dismissedAt?, completedAt? }
  onboarding      Json      @default("{}")
  createdAt       DateTime  @default(now())

  branches       Branch[]
  users          User[]
  courses        Course[]
  groups         Group[]
  holidays       Holiday[]
  families       Family[]
  students       Student[]
  ledger         LedgerEntry[]
  expenses       Expense[]
  leads          Lead[]
  auditLogs      AuditLog[]
  paymeTxs       PaymeTransaction[]
  clickTxs       ClickTransaction[]
  uzumTxs        UzumTransaction[]
  notifications  Notification[]
  reportCards    ReportCard[]
  exams          Exam[]
  certificates   Certificate[]
  agentChats     AgentChat[]
  agentUsage     AgentUsage[]
  bot            CenterBot?
  homeworks      Homework[]
  questionTopics QuestionTopic[]
  questions      Question[]
  quizzes        Quiz[]
}

model Branch {
  id         String    @id @default(cuid())
  centerId   String
  center     Center    @relation(fields: [centerId], references: [id])
  name       String
  address    String?
  phone      String?
  /// map point (WGS84) for the AI agent's "send location"; set from coordinates or a map link in settings
  latitude   Float?
  longitude  Float?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  rooms    Room[]
  groups   Group[]
  users    UserBranch[]
  expenses Expense[]
  leads    Lead[]
  students Student[]
  exams    Exam[]

  @@index([centerId])
}

model Room {
  id         String    @id @default(cuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  name       String
  capacity   Int?
  archivedAt DateTime?

  groups  Group[]
  lessons Lesson[]

  @@index([branchId])
}

model User {
  id                 String    @id @default(cuid())
  centerId           String
  center             Center    @relation(fields: [centerId], references: [id])
  phone              String    @unique
  name               String
  passwordHash       String
  role               Role
  isTeacher          Boolean   @default(false)
  perms              String[]
  telegramChatId     String?
  locale             String?
  /// public text about a teacher (experience, results) — the only profile field the AI agent may show customers
  bio                String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  /// sessions issued before this moment are rejected (password changed or reset)
  passwordChangedAt  DateTime?
  /// set by an admin reset: the user must pick a new password after signing in
  mustChangePassword Boolean   @default(false)
  /// signup consent to the public offer and privacy policy: when, and which text version (BRAND.legal.version)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  /// platform (super) admin: granted only by an operator (scripts/platform-admin.ts), never by phone
  platformAdmin      Boolean   @default(false)

  branches       UserBranch[]
  passwordResets PasswordReset[]
  groups         Group[]            @relation("GroupTeacher")
  lessons        Lesson[]           @relation("LessonTeacher")
  markedLessons  Lesson[]           @relation("LessonMarkedBy")
  salaryRules    SalaryRule[]
  adjustments    SalaryAdjustment[] @relation("AdjTeacher")
  payslips       Payslip[]          @relation("PayslipTeacher")
  assignedLeads  Lead[]             @relation("LeadAssignee")

  @@index([centerId])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
}

model Course {
  id             String      @id @default(cuid())
  centerId       String
  center         Center      @relation(fields: [centerId], references: [id])
  name           String
  level          String?
  description    String?
  lessonMinutes  Int         @default(90)
  lessonsPerWeek Int?
  durationMonths Int?
  pricingType    PricingType
  price          Int
  renewal        Renewal     @default(CALENDAR)
  /// CALENDAR only: the day of the month each billing month starts (1 = calendar months; 15 = the 15th to the 14th).
  renewalDay     Int         @default(1)
  packageLessons Int?
  installments   Int         @default(1)
  /// [{ from: "YYYY-MM-DD", price: Int }] — earlier prices; `price` applies after the last entry.
  priceHistory   Json        @default("[]")
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())

  groups Group[]
  leads  Lead[]
  exams  Exam[]

  @@index([centerId])
}

model Group {
  id             String         @id @default(cuid())
  centerId       String
  center         Center         @relation(fields: [centerId], references: [id])
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        User           @relation("GroupTeacher", fields: [teacherId], references: [id])
  roomId         String?
  room           Room?          @relation(fields: [roomId], references: [id])
  code           Int
  name           String
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  capacity       Int?
  priceOverride  Int?
  /// [{ from, price }] — group price override changes (price null = course price); current field applies after the last.
  priceHistory   Json           @default("[]")
  status         GroupStatus    @default(ACTIVE)
  /// the bank topic the group is at now, set by the owner (topic tests, placement suggestions)
  currentTopicId String?
  currentTopic   QuestionTopic? @relation("GroupCurrentTopic", fields: [currentTopicId], references: [id])
  createdAt      DateTime       @default(now())

  slots       GroupSlot[]
  lessons     Lesson[]
  enrollments Enrollment[]
  reportCards ReportCard[]
  exams       Exam[]
  homeworks   Homework[]
  quizzes     Quiz[]

  @@unique([centerId, code])
  @@index([centerId, createdAt])
  @@index([branchId])
  @@index([teacherId])
  @@index([courseId])
  @@index([roomId])
}

model GroupSlot {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String

  @@index([groupId])
}

model Lesson {
  id            String       @id @default(cuid())
  groupId       String
  group         Group        @relation(fields: [groupId], references: [id])
  date          DateTime     @db.Date
  startTime     String
  endTime       String
  teacherId     String
  teacher       User         @relation("LessonTeacher", fields: [teacherId], references: [id])
  roomId        String?
  room          Room?        @relation(fields: [roomId], references: [id])
  status        LessonStatus @default(SCHEDULED)
  cancelReason  String?
  topic         String?
  heldAt        DateTime?
  markedById    String?
  markedBy      User?        @relation("LessonMarkedBy", fields: [markedById], references: [id])
  /// Set when a lesson is rescheduled: the slot it came from, so generation never recreates it.
  origDate      DateTime?    @db.Date
  origStartTime String?
  createdAt     DateTime     @default(now())

  attendance Attendance[]
  ledger     LedgerEntry[]
  homework   Homework?

  @@unique([groupId, date, startTime])
  @@index([groupId, date])
  @@index([teacherId, date])
  @@index([roomId, date])
  @@index([date])
}

model Holiday {
  id       String   @id @default(cuid())
  centerId String
  center   Center   @relation(fields: [centerId], references: [id])
  date     DateTime @db.Date
  name     String

  @@unique([centerId, date])
}

model Family {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  name      String
  createdAt DateTime @default(now())

  guardians Guardian[]
  students  Student[]
  ledger    LedgerEntry[]
  paymeTxs  PaymeTransaction[]
  clickTxs  ClickTransaction[]
  uzumTxs   UzumTransaction[]
  balance   FamilyBalance?

  @@index([centerId, createdAt])
}

/// The family's FIFO allocation reduced to what debt lists and aging need (src/lib/billing/balance-cache.ts).
/// Written only by the cache refresher; a trigger on LedgerEntry queues the family in FamilyBalanceDirty
/// whenever its ledger changes, and readers refresh queued families before they read.
model FamilyBalance {
  familyId         String    @id
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  centerId         String
  /// SUM(ledger); negative = debt
  balance          BigInt
  totalDebt        BigInt
  oldestUnpaidDate DateTime? @db.Date
  /// unpaid money by the date it became due: [{ "d": "2026-09-01", "a": 150000 }]
  dues             Json      @default("[]")
  updatedAt        DateTime  @default(now())

  @@index([centerId, balance])
}

/// Families whose ledger changed since their FamilyBalance was computed. Insert-only from the trigger;
/// the refresher deletes exactly the rows it has seen.
model FamilyBalanceDirty {
  id        BigInt   @id @default(autoincrement())
  centerId  String
  familyId  String
  createdAt DateTime @default(now())

  @@index([centerId, familyId])
}

model Guardian {
  id             String  @id @default(cuid())
  familyId       String
  family         Family  @relation(fields: [familyId], references: [id])
  name           String
  phone          String
  relation       String?
  telegramChatId String?
  isPrimary      Boolean @default(false)

  @@index([familyId])
  @@index([phone])
}

model Student {
  id             String        @id @default(cuid())
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id])
  familyId       String
  family         Family        @relation(fields: [familyId], references: [id])
  /// Home branch (where the student was registered); branch scoping also follows enrollments.
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  firstName      String
  lastName       String
  phone          String?
  birthDate      DateTime?     @db.Date
  gender         String?
  source         String?
  tags           String[]
  /// school class 1–11 (null = unknown / not a schoolchild); homework goes to the student or the parents by it (settings.homework.directFromGrade)
  schoolGrade    Int?
  notes          String?
  telegramChatId String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())

  enrollments  Enrollment[]
  attendance   Attendance[]
  ledger       LedgerEntry[]
  leads        Lead[]
  reportCards  ReportCard[]
  examResults  ExamResult[]
  certificates Certificate[]
  homeworks    HomeworkSubmission[]
  quizAttempts QuizAttempt[]

  @@index([centerId, createdAt])
  @@index([familyId])
  @@index([phone])
  @@index([centerId, lastName, firstName])
  @@index([branchId])
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  groupId         String
  group           Group            @relation(fields: [groupId], references: [id])
  startDate       DateTime         @db.Date
  endDate         DateTime?        @db.Date
  activatedAt     DateTime?        @db.Date
  status          EnrollmentStatus @default(TRIAL)
  priceOverride   Int?
  discountPercent Int?
  discountAmount  Int?
  discountUntil   DateTime?        @db.Date
  discountReason  String?
  leftReason      String?
  /// [{ from, priceOverride, discountPercent, discountAmount, discountUntil }] — earlier terms; current fields apply after the last entry.
  termsHistory    Json             @default("[]")
  transferredToId String?
  transferredTo   Enrollment?      @relation("Transfer", fields: [transferredToId], references: [id])
  transferredFrom Enrollment[]     @relation("Transfer")
  createdAt       DateTime         @default(now())

  freezes     EnrollmentFreeze[]
  attendance  Attendance[]
  ledger      LedgerEntry[]
  reportCards ReportCard[]

  @@index([studentId])
  @@index([groupId])
  @@index([endDate])
}

model EnrollmentFreeze {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  fromDate     DateTime   @db.Date
  toDate       DateTime   @db.Date
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
}

model Attendance {
  id           String           @id @default(cuid())
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  status       AttendanceStatus
  grade        Int?
  comment      String?
  markedById   String?
  updatedAt    DateTime         @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
}

model LedgerEntry {
  id           String         @id @default(cuid())
  centerId     String
  center       Center         @relation(fields: [centerId], references: [id])
  familyId     String
  family       Family         @relation(fields: [familyId], references: [id])
  studentId    String?
  student      Student?       @relation(fields: [studentId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?    @relation(fields: [enrollmentId], references: [id])
  lessonId     String?
  lesson       Lesson?        @relation(fields: [lessonId], references: [id])
  type         LedgerType
  amount       Int
  method       PaymentMethod?
  billingKey   String?
  period       String?
  description  String
  reversesId   String?        @unique
  reverses     LedgerEntry?   @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy   LedgerEntry?   @relation("Reversal")
  receiptNo    Int?
  date         DateTime       @db.Date
  createdById  String?
  externalId   String?
  createdAt    DateTime       @default(now())

  paymeTx PaymeTransaction?
  clickTx ClickTransaction?
  uzumTx  UzumTransaction?

  @@index([familyId])
  @@index([billingKey])
  @@index([enrollmentId])
  @@index([centerId, date])
  @@index([centerId, createdAt])
  @@index([studentId])
  @@index([lessonId])
}

model SalaryRule {
  id          String      @id @default(cuid())
  teacherId   String
  teacher     User        @relation(fields: [teacherId], references: [id])
  model       SalaryModel
  percent     Int?
  fixedAmount Int?
  perLesson   Int?
  validFrom   DateTime    @db.Date
  createdAt   DateTime    @default(now())

  @@index([teacherId, validFrom])
}

model SalaryAdjustment {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("AdjTeacher", fields: [teacherId], references: [id])
  month       String
  amount      Int
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  @@index([teacherId, month])
}

model Payslip {
  id         String        @id @default(cuid())
  teacherId  String
  teacher    User          @relation("PayslipTeacher", fields: [teacherId], references: [id])
  month      String
  status     PayslipStatus @default(DRAFT)
  total      Int
  lines      Json
  lockedAt   DateTime?
  lockedById String?
  paidAt     DateTime?
  paidById   String?
  expenseId  String?

  @@unique([teacherId, month])
}

model Expense {
  id          String    @id @default(cuid())
  centerId    String
  center      Center    @relation(fields: [centerId], references: [id])
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  category    String
  amount      Int
  date        DateTime  @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  reversedAt  DateTime?

  @@index([centerId, date])
  @@index([centerId, createdAt])
}

model Lead {
  id            String    @id @default(cuid())
  centerId      String
  center        Center    @relation(fields: [centerId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  name          String
  /// null only for a Telegram AI lead that has not shared a number yet (follow-up goes through the bot)
  phone         String?
  source        String?
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id])
  stage         LeadStage @default(NEW)
  assignedToId  String?
  assignedTo    User?     @relation("LeadAssignee", fields: [assignedToId], references: [id])
  nextContactAt DateTime? @db.Date
  lostReason    String?
  tags          String[]
  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id])
  utm           Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  notes        LeadNote[]
  examResults  ExamResult[]
  agentChats   AgentChat[]
  quizAttempts QuizAttempt[]

  @@index([centerId, createdAt])
  @@index([centerId, stage])
  @@index([phone])
}

model LeadNote {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  text        String
  createdById String?
  actor       ActorKind @default(USER)
  createdAt   DateTime  @default(now())

  @@index([leadId])
}

model AuditLog {
  id        String    @id @default(cuid())
  centerId  String
  center    Center    @relation(fields: [centerId], references: [id])
  userId    String?
  actor     ActorKind @default(SYSTEM)
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime  @default(now())

  @@index([centerId, createdAt])
  @@index([entity, entityId])
}

/// One AI lead agent conversation: a Telegram chat talking to one center's agent (src/lib/agent).
model AgentChat {
  id               String   @id @default(cuid())
  centerId         String
  center           Center   @relation(fields: [centerId], references: [id])
  chatId           String
  /// Telegram @username (without @), if the person has one: staff can write to them directly
  username         String?
  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id])
  /// the student the agent created for this chat (reused if a trial booking is retried)
  studentId        String?
  /// every student this chat booked (a parent may book two children): the state block and cancel_trial read it
  studentIds       String[] @default([])
  trialGroupId     String?
  /// contact phone (998…): stored here and on the lead, never sent to the model
  phone            String?
  /// "telegram" = shared with the contact button (Telegram-verified), "typed" = written by hand
  phoneSource      String?
  awaitingPhone    Boolean  @default(false)
  /// Messages API history (user/assistant content blocks), trimmed by src/lib/agent/history.ts
  messages         Json     @default("[]")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  /// prompt caching: tokens read from / written to the cache (inputTokens is the uncached rest)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([centerId, chatId])
  @@index([chatId, lastMessageAt])
  @@index([leadId])
}

/// AI agent token usage per center and calendar month (YYYY-MM): metering and the monthly cap.
model AgentUsage {
  centerId         String
  center           Center @relation(fields: [centerId], references: [id])
  month            String
  inputTokens      Int    @default(0)
  outputTokens     Int    @default(0)
  /// prompt caching: read ~0.1x, write ~1.25x the input price; inputTokens is the uncached rest
  cacheReadTokens  Int    @default(0)
  cacheWriteTokens Int    @default(0)
  calls            Int    @default(0)

  @@id([centerId, month])
}

/// Sabaq's own sales agent (SALES_AGENT=true): a stranger who writes to the shared bot without a center link
/// talks to Sabaq itself, not to a center. Not tied to any center; the nightly demo reset keeps these tables.
model SalesChat {
  id               String   @id @default(cuid())
  chatId           String   @unique
  /// Telegram name and @username (without @) of the person, for the team's notifications
  name             String?
  username         String?
  /// contact phone (998…): never sent to the model
  phone            String?
  awaitingPhone    Boolean  @default(false)
  /// Messages API history (user/assistant content blocks), trimmed by src/lib/agent/history.ts
  messages         Json     @default("[]")
  /// the bot's messages to the team about this chat: a reply to one of them goes back to the person
  teamMessageIds   Int[]    @default([])
  /// center setup done in the chat (src/lib/sales-agent/onboarding.ts): status, the draft, the files' Telegram ids
  onboarding       Json     @default("{}")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())
}

/// Sales agent token usage per calendar month (YYYY-MM): the monthly cap (SALES_MONTHLY_TOKEN_CAP).
model SalesUsage {
  month            String @id
  inputTokens      Int    @default(0)
  outputTokens     Int    @default(0)
  cacheReadTokens  Int    @default(0)
  cacheWriteTokens Int    @default(0)
  calls            Int    @default(0)
}

model PaymeTransaction {
  id            String       @id @default(cuid())
  centerId      String
  center        Center       @relation(fields: [centerId], references: [id])
  paymeId       String       @unique
  familyId      String
  family        Family       @relation(fields: [familyId], references: [id])
  amountTiyin   BigInt
  state         Int
  createTime    BigInt
  /// Payme's own creation time (CreateTransaction "time"), reported back in GetStatement.
  paymeTime     BigInt?
  performTime   BigInt?
  cancelTime    BigInt?
  reason        Int?
  ledgerEntryId String?      @unique
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([familyId, state])
  @@index([centerId, createTime])
}

/// Click SHOP-API payment (Prepare → Complete). state: 0 prepared, 1 confirmed, -1 cancelled.
model ClickTransaction {
  id            String       @id @default(cuid())
  centerId      String
  center        Center       @relation(fields: [centerId], references: [id])
  clickTransId  String       @unique
  clickPaydocId String?
  familyId      String
  family        Family       @relation(fields: [familyId], references: [id])
  /// whole so'm
  amount        Int
  /// merchant_prepare_id / merchant_confirm_id we answer with (Click wants an integer)
  prepareId     Int          @unique @default(autoincrement())
  state         Int          @default(0)
  /// Click's error code when it cancelled the payment in Complete
  error         Int?
  ledgerEntryId String?      @unique
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([familyId])
  @@index([centerId, createdAt])
}

enum UzumState {
  CREATED
  CONFIRMED
  REVERSED
  FAILED
}

/// Uzum Bank Merchant API payment (check → create → confirm, or reverse). Times are ms since epoch.
model UzumTransaction {
  id            String       @id @default(cuid())
  centerId      String
  center        Center       @relation(fields: [centerId], references: [id])
  transId       String       @unique
  familyId      String
  family        Family       @relation(fields: [familyId], references: [id])
  amountTiyin   BigInt
  state         UzumState    @default(CREATED)
  createTime    BigInt
  confirmTime   BigInt?
  reverseTime   BigInt?
  paymentSource String?
  ledgerEntryId String?      @unique
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([familyId])
  @@index([centerId, createTime])
}

enum ReportCardStatus {
  DRAFT
  SENT
}

/// Monthly report card of one enrollment (v2). While DRAFT the numbers are computed live from attendance;
/// sending freezes them into `data` and gives parents the public link /rc/<token>.
model ReportCard {
  id             String           @id @default(cuid())
  centerId       String
  center         Center           @relation(fields: [centerId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  enrollmentId   String
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id])
  groupId        String
  group          Group            @relation(fields: [groupId], references: [id])
  /// YYYY-MM
  month          String
  teacherComment String?
  commentById    String?
  /// Progress snapshot (src/lib/academics/progress.ts) frozen when sent
  data           Json?
  status         ReportCardStatus @default(DRAFT)
  /// unguessable id of the parents' public page
  token          String           @unique
  sentAt         DateTime?
  sentById       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([enrollmentId, month])
  @@index([centerId, month])
  @@index([groupId, month])
  @@index([studentId])
}

enum ExamKind {
  PLACEMENT
  LEVEL
  FINAL
  MOCK
}

/// An exam (v2): placement test (leads or students), level / final exam of a group, or a mock exam.
model Exam {
  id          String    @id @default(cuid())
  centerId    String
  center      Center    @relation(fields: [centerId], references: [id])
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id])
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id])
  kind        ExamKind
  title       String
  date        DateTime  @db.Date
  maxScore    Int       @default(100)
  /// null = no pass mark (placement, mock)
  passScore   Int?
  /// [{ name, max }] — e.g. Listening / Reading / Writing / Speaking; [] = one total score
  sections    Json      @default("[]")
  /// placement: [{ min, level }] — the highest band whose min ≤ score is the recommended level
  levelBands  Json      @default("[]")
  /// results were sent to parents
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  results      ExamResult[]
  certificates Certificate[]

  @@index([centerId, date])
  @@index([groupId])
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  /// a student, or (placement) a lead who is not a student yet
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id])
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  score         Int
  /// per section, in the exam's section order
  sectionScores Json     @default("[]")
  passed        Boolean?
  level         String?
  comment       String?
  enteredById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  certificate Certificate?

  @@unique([examId, studentId])
  @@unique([examId, leadId])
  @@index([studentId])
  @@index([leadId])
}

/// A printable certificate (v2), verifiable by anyone at /v/<code>. Never deleted: revoked instead.
model Certificate {
  id           String      @id @default(cuid())
  centerId     String
  center       Center      @relation(fields: [centerId], references: [id])
  /// "2026-0007": year of issue + the center's running number
  number       String
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id])
  examResultId String?     @unique
  examResult   ExamResult? @relation(fields: [examResultId], references: [id])
  groupId      String?
  courseId     String?
  title        String
  level        String?
  score        Int?
  maxScore     Int?
  issuedAt     DateTime    @db.Date
  issuedById   String?
  /// public verification code (10 characters, no look-alike letters)
  code         String      @unique
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?
  createdAt    DateTime    @default(now())

  @@unique([centerId, number])
  @@index([studentId])
  @@index([centerId, issuedAt])
}

model TelegramLink {
  id        String   @id @default(cuid())
  chatId    String
  kind      LinkKind
  refId     String
  phone     String
  locale    String?
  createdAt DateTime @default(now())

  @@unique([chatId, kind, refId])
  @@index([chatId])
}

model Notification {
  id            String              @id @default(cuid())
  centerId      String
  center        Center              @relation(fields: [centerId], references: [id])
  channel       NotificationChannel @default(TELEGRAM)
  /// destination: the Telegram chat id, or the phone (998…) for SMS
  chatId        String
  text          String
  /// optional Bot API rich-message HTML (sendRichMessage); sent instead of `text` only when
  /// TELEGRAM_RICH_MESSAGES=true, and `text` is the fallback if Telegram refuses it. Never used for SMS.
  richText      String?
  /// optional button under the message that opens the Mini App: { text, path } ("/tg/quiz?q=…"); the sender
  /// builds the URL for the bot that delivers it (a center's own bot adds ?b=<bot id>). Telegram only.
  button        Json?
  /// the center's own bot that delivered it (CenterBot.botId); null = the shared bot or not sent yet
  sentVia       String?
  dedupeKey     String?             @unique
  status        NotificationStatus  @default(PENDING)
  error         String?
  attempts      Int                 @default(0)
  /// not sent before this moment (backoff after an error or Telegram 429)
  nextAttemptAt DateTime            @default(now())
  /// set while a sender holds the row (status SENDING); stale claims are taken back
  lockedAt      DateTime?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([channel, status, nextAttemptAt])
}

/// Login and reset-code attempts for rate limiting (key = "login:phone:998…", "login:ip:…", "reset:…").
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// One-time code sent to a staff member's linked Telegram chat to set a new password.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A center's own Telegram bot, created through Telegram's managed bots (Bot API 9.6) and controlled by
/// the shared bot. The token is never stored: it is read with getManagedBotToken (src/lib/managed-bots).
model CenterBot {
  /// the bot's Telegram user id (string, like chatId)
  botId     String          @id
  centerId  String          @unique
  center    Center          @relation(fields: [centerId], references: [id])
  username  String
  name      String
  /// Telegram user id of the bot's owner: the creator, updated when Telegram reports an owner change
  ownerTgId String
  status    CenterBotStatus @default(TESTING)
  lastError String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chats     BotChat[]
}

enum CenterBotStatus {
  /// only the owner can open it (setManagedBotAccessSettings); messages still go through the shared bot
  TESTING
  /// open to everyone; the center's messages go through it to people who started it
  ACTIVE
  /// center disabled, pilot access removed or switched off in Settings: not polled, shared bot used
  PAUSED
  /// deleted, or its token can't be read: not polled, shared bot used
  GONE
}

/// Who started which center bot: a bot can only message people who started it.
model BotChat {
  botId     String
  bot       CenterBot @relation(fields: [botId], references: [botId], onDelete: Cascade)
  chatId    String
  startedAt DateTime  @default(now())
  /// the person blocked this bot (403): messages go through the shared bot again
  blockedAt DateTime?

  @@id([botId, chatId])
  @@index([chatId])
}

/// One-time code behind "Create our bot" in Settings: 10 minutes, single use.
model BotCreateRequest {
  code      String    @id
  centerId  String
  /// the OWNER who pressed the button
  userId    String
  /// the shared-bot chat that opened the code (must be that owner's linked chat)
  chatId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([chatId])
}

/// Homework set at a lesson (pilot, used only while settings.homework.enabled): the teacher's answer key.
/// Students answer in the Telegram bot and code grades every answer (src/lib/homework/grade.ts), never a model.
/// Open from the lesson's end until the group's next lesson starts — computed on read, so a moved lesson moves it.
model Homework {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  lessonId    String   @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  /// answer key in question order: "B", "-4", "2.5", "3/4"; several accepted answers joined by "|" ("2|-2")
  answers     String[]
  /// the task in the teacher's words, shown to students ("darslik 45-bet, 1–20")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions HomeworkSubmission[]

  @@index([groupId])
  @@index([centerId, createdAt])
}

/// One student's answers to a homework, saved one by one as they are given (a student or a parent answers
/// in the bot) and changeable until the deadline. No grade is stored: it is computed from the current key,
/// so a corrected key re-grades everyone.
model HomeworkSubmission {
  id              String    @id @default(cuid())
  homeworkId      String
  homework        Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  /// in question order; "" = not answered
  answers         String[]
  /// the Telegram chat that answered last (the student's or a parent's)
  chatId          String?
  /// times the student pressed "check" (settings.homework.attempts at most)
  checks          Int       @default(0)
  /// the answers at the first check: the class report is built from them, so retries do not hide mistakes
  firstAnswers    String[]  @default([])
  /// the answers at the last check: questions right here are locked
  checkedAnswers  String[]  @default([])
  /// the first non-empty answer: after the deadline it marks the submission as late
  firstAnsweredAt DateTime?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

// ------------------------------------------------------------------ question bank

/// Where a question came from.
enum QuestionSource {
  /// read from the center's own book or test collection (scripts/import-questions.ts)
  BOOK
  /// written by the center's AI agent at a teacher's request
  AGENT
  /// typed by a teacher
  TEACHER
}

/// A question is used (placement and topic tests) only once someone at the center approved it.
enum QuestionStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// How sure the key is, before a person approves it. The model only proposes keys; a person decides.
enum KeyCheck {
  /// the book prints the answer (a worked solution's "Javob", an answer table) and two independent solves agree with it
  STATED
  /// no printed answer; two independent model solves agree
  AGREED
  /// the solves disagree with each other or with the printed answer: a person must pick the key
  CONFLICT
  /// no key could be found (the model could not solve it, or the question needs a picture)
  UNKNOWN
}

/// A topic of the center's question bank, in teaching order: "1.1.1 Hisoblashga oid misollar" (the book's
/// own section numbers). Sub-topics are found by code prefix ("1.1" holds "1.1.1"…).
model QuestionTopic {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  /// "1", "1.1", "1.1.1"; sorts by its numeric parts
  code      String
  title     String
  createdAt DateTime @default(now())

  questions Question[]
  groupsAt  Group[]       @relation("GroupCurrentTopic")
  quizzes   Quiz[]
  attempts  QuizAttempt[]

  @@unique([centerId, code])
}

/// One test question of a center: multiple choice (options A–E, key a letter) or open (no options, key a
/// number as in homework keys). Plain text with simple math (x², √(x+1), 3/4) so Telegram can show it.
model Question {
  id           String         @id @default(cuid())
  centerId     String
  center       Center         @relation(fields: [centerId], references: [id])
  topicId      String
  topic        QuestionTopic  @relation(fields: [topicId], references: [id])
  /// the question's number within its topic in the source ("1.1.1" no. 7)
  number       Int?
  text         String
  /// A, B, C… in order; [] = open answer
  options      String[]
  /// the key in homework-key form: "B", "-4", "2|-2"; "" = none yet
  answer       String
  keyCheck     KeyCheck
  /// what the book prints as the answer, when it does
  statedAnswer String?
  /// the two independent model solves ("B", "C"); kept for the reviewer
  solves       String[]       @default([])
  /// the book's worked solution, when it has one
  solution     String?
  /// the question needs a picture (a graph, a drawing) that the text cannot carry
  needsFigure  Boolean        @default(false)
  source       QuestionSource
  /// "96-3-1" (DTM bulletin 1996, no. 3, question 1) or "p. 12"
  sourceRef    String?
  page         Int?
  status       QuestionStatus @default(DRAFT)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([topicId, number])
  @@index([centerId, status])
}

// ------------------------------------------------------------------ quizzes (timed tests in the Mini App)

enum QuizKind {
  /// a test on a topic for a group, built from the bank's approved questions
  TOPIC
  /// the center's placement test template: each attempt draws its own questions up to the topic reached
  PLACEMENT
}

enum QuizStatus {
  /// the owner reviews the questions; nobody can take it
  DRAFT
  /// open: the group was told, students can start (placement: the start link works)
  PUBLISHED
  /// no new attempts; running ones are finished
  CLOSED
}

/// A timed test taken in the Telegram Mini App. Questions come from the center's bank (approved ones only);
/// code grades every answer from the question's key (src/lib/quizzes/grade.ts), never a model.
model Quiz {
  id            String         @id @default(cuid())
  centerId      String
  center        Center         @relation(fields: [centerId], references: [id])
  kind          QuizKind       @default(TOPIC)
  title         String
  /// TOPIC: the group it is for; PLACEMENT: null
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id])
  /// TOPIC: the topic the questions come from (with its sub-topics)
  topicId       String?
  topic         QuestionTopic? @relation(fields: [topicId], references: [id])
  /// time limit per attempt, from the moment the student starts
  minutes       Int
  /// TOPIC: question ids in order; PLACEMENT: [] (each attempt draws its own)
  questionIds   String[]       @default([])
  /// PLACEMENT: questions per attempt
  questionCount Int            @default(0)
  passPercent   Int            @default(70)
  status        QuizStatus     @default(DRAFT)
  publishedAt   DateTime?
  closedAt      DateTime?
  /// the last time the owner sent the results to the parents (their permission is this button)
  parentsSentAt DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  attempts QuizAttempt[]

  @@index([centerId, kind, createdAt])
  @@index([groupId])
}

/// One person's run through a quiz: a student (topic tests; a known student on placement) or a lead (placement).
/// Answers are saved one by one; past the deadline nothing is accepted and the attempt is finished by code.
model QuizAttempt {
  id                 String         @id @default(cuid())
  quizId             String
  quiz               Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId          String?
  student            Student?       @relation(fields: [studentId], references: [id])
  leadId             String?
  lead               Lead?          @relation(fields: [leadId], references: [id])
  /// the Telegram chat that started it (the student's own or a parent's)
  chatId             String
  /// PLACEMENT: the name typed in the Mini App (the person being placed)
  name               String?
  /// PLACEMENT: the topic the person said they reached
  topicId            String?
  topic              QuestionTopic? @relation(fields: [topicId], references: [id])
  /// this attempt's questions in order (a topic test copies the quiz's)
  questionIds        String[]
  /// in question order; "" = not answered
  answers            String[]       @default([])
  startedAt          DateTime       @default(now())
  deadlineAt         DateTime
  submittedAt        DateTime?
  /// finished by code at the deadline, not by the student
  autoSubmitted      Boolean        @default(false)
  correct            Int?
  total              Int
  /// PLACEMENT: the owner's decision (enrolled as TRIAL into this group)
  placedGroupId      String?
  placedEnrollmentId String?
  placedAt           DateTime?
  placedById         String?
  createdAt          DateTime       @default(now())

  @@unique([quizId, studentId])
  @@index([quizId, createdAt])
  @@index([chatId])
  @@index([submittedAt, deadlineAt])
}
