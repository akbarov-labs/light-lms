{
  "name": "lms-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "seed": "SEED_DEMO=true tsx prisma/seed-if-empty.ts",
    "seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "job:lessons": "tsx src/worker/run-job.ts lessons",
    "job:nightly": "tsx src/worker/run-job.ts nightly",
    "job:billing": "tsx src/worker/run-job.ts billing",
    "job:balances": "tsx src/worker/run-job.ts balances",
    "job:reminders": "tsx src/worker/run-job.ts reminders",
    "job:teacher-reminders": "tsx src/worker/run-job.ts teacher-reminders",
    "job:daily-report": "tsx src/worker/run-job.ts daily-report",
    "job:report-cards": "tsx src/worker/run-job.ts report-cards",
    "job:notifications": "tsx src/worker/run-job.ts notifications",
    "job:sms": "tsx src/worker/run-job.ts sms",
    "job:demo-reset": "tsx src/worker/run-job.ts demo-reset",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "geist": "1.7.2",
    "grammy": "1.46.0",
    "jose": "6.2.12",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "node-cron": "4.6.0",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
