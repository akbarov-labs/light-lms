{
  "name": "lms-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "job:lessons": "tsx src/worker/run-job.ts lessons",
    "job:nightly": "tsx src/worker/run-job.ts nightly",
    "job:billing": "tsx src/worker/run-job.ts billing",
    "job:reminders": "tsx src/worker/run-job.ts reminders",
    "job:teacher-reminders": "tsx src/worker/run-job.ts teacher-reminders",
    "job:daily-report": "tsx src/worker/run-job.ts daily-report",
    "job:notifications": "tsx src/worker/run-job.ts notifications",
    "job:demo-reset": "tsx src/worker/run-job.ts demo-reset",
    "test:integration": "tsx scripts/test-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "geist": "1.7.2",
    "grammy": "1.46.0",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "next": "15.5.27",
    "node-cron": "4.6.0",
    "prisma": "6.19.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.20.4",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
