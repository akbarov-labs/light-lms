# --- lms-light PRODUCTION settings (docker-compose.prod.yml). Copy to .env on the server and fill in. ---
# Never commit the real .env. Keep a copy of it (and of the backups) somewhere off the server.

# Domain pointing at this server (DNS A record). Caddy gets the HTTPS certificate for it automatically.
DOMAIN=crm.example.uz

# Database password. Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login sessions. At least 32 random characters: openssl rand -base64 32
# The app refuses to start over HTTPS with a weak or example value.
AUTH_SECRET=

# Optional. Telegram bot token from @BotFather (bot, reminders, password reset codes). Empty = bot off.
TELEGRAM_BOT_TOKEN=

# Leave false in production (true fills an EMPTY database with the demo center).
SEED_DEMO=false

# Backups: when (cron, Asia/Tashkent time), how many days to keep, and where on the server.
BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# Only change for a local test of this file (e.g. DOMAIN=localhost, HTTPS_PORT=8443, APP_URL=https://localhost:8443).
# HTTP_PORT=80
# HTTPS_PORT=443
# APP_URL=https://crm.example.uz


# Public demo (optional, see .env.example). Main site: DEMO_URL=https://demo.example.uz/demo
# Separate demo server only: DEMO_MODE=true, SEED_DEMO=true, MAIN_SITE_URL=https://crm.example.uz
# NEVER set DEMO_MODE=true on the server with real centers — it wipes the database every night.
DEMO_MODE=false
DEMO_URL=
MAIN_SITE_URL=

# Ops alerts (optional, free): your own Telegram chat id. With TELEGRAM_BOT_TOKEN set, server errors, failed
# jobs and a missing nightly backup are sent there. Get the id: write to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id.
OPS_TELEGRAM_CHAT_ID=

# Database connections (optional; defaults shown). Web up to DB_POOL_MAX, worker up to WORKER_DB_POOL_MAX;
# keep their sum + 5 below Postgres max_connections (100). A query waits DB_POOL_TIMEOUT_MS for a connection.
# DB_POOL_MAX=20
# WORKER_DB_POOL_MAX=10
# DB_POOL_TIMEOUT_MS=15000
