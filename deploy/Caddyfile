# Caddy gets and renews the Let's Encrypt certificate for {$DOMAIN} by itself (ports 80 and 443 must be open).
# It replaces any X-Forwarded-For sent by the client with the real address, which login limiting relies on.
{$DOMAIN} {
	encode zstd gzip

	# receipts and imports are small; refuse huge bodies early
	request_body {
		max_size 10MB
	}

	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}
