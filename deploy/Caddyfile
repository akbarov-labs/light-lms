# Caddy gets and renews the Let's Encrypt certificate for {$DOMAIN} by itself (ports 80 and 443 must be open).
# It replaces any X-Forwarded-For sent by the client with the real address, which login limiting relies on.
# EXTRA_DOMAINS (optional, space-separated, each with its own DNS record) redirect to {$DOMAIN} with a 301,
# e.g. EXTRA_DOMAINS=www.sabaq.uz or an old address of the same server.
{$DOMAIN} {$EXTRA_DOMAINS} {
	@other not host {$DOMAIN}
	redir @other https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	# receipts and imports are small; refuse huge bodies early
	request_body {
		max_size 10MB
	}

	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}
