# --- lms-light configuration (copy to .env; every value has a safe local default) ---

# Postgres connection. Inside Docker Compose the host is "db"; for `npm run dev` use localhost:${DB_PORT}.
DATABASE_URL=postgresql://lms:lms@localhost:5433/lms?schema=public

# Secret used to sign login sessions (JWT). Generate one: `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the web app (used in Telegram messages, receipts and Payme return links).
APP_URL=http://localhost:3000

# true only when a reverse proxy you control overwrites X-Forwarded-For (docker-compose.prod.yml sets it
# for Caddy). Otherwise the header is ignored, because any client could fake it to dodge login limits.
TRUST_PROXY=false

# Optional. Telegram bot token from @BotFather. Empty = bot disabled, worker still runs jobs.
TELEGRAM_BOT_TOKEN=

# true = on first start, fill an empty database with the demo center (logins in README).
SEED_DEMO=true


# Timezone for all jobs and "today" calculations.
TZ=Asia/Tashkent

# Host ports Docker Compose publishes (change if something else already uses them).
WEB_PORT=3000
DB_PORT=5433
# Address the web port is published on. 127.0.0.1 = this computer only; 0.0.0.0 = the local network too
# (e.g. testing the teacher pages on a phone over Wi-Fi). Production uses docker-compose.prod.yml (Caddy) instead.
WEB_BIND=127.0.0.1

# true only behind your own reverse proxy that overwrites X-Forwarded-For (Caddy in docker-compose.prod.yml).
# Otherwise anyone could fake their IP and dodge the login / signup / lead-form limits.
TRUST_PROXY=false

# Database connections per process. The web app opens up to DB_POOL_MAX (default 20), the worker up to
# WORKER_DB_POOL_MAX (default 10, set by docker compose). Keep web + worker + 5 below Postgres' max_connections (100).
# A query waits at most DB_POOL_TIMEOUT_MS for a free connection, then fails instead of hanging.
# DB_POOL_MAX=20
# WORKER_DB_POOL_MAX=10
# DB_POOL_TIMEOUT_MS=15000

# Worker heartbeat file (the compose healthcheck reads it). Rarely changed.
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# Public demo (optional). On the main site set DEMO_URL to the demo server's /demo link (e.g. https://demo.example.uz/demo)
# so the landing page shows "See the demo". On a separate demo server set DEMO_MODE=true (+ SEED_DEMO=true):
# /demo signs visitors in as the demo owner, passwords/staff/center settings are locked, and the worker wipes and
# re-seeds the database every night at 04:00. NEVER set DEMO_MODE=true on a server with real centers.
DEMO_MODE=false
DEMO_URL=
# On the demo server: the main site's address, so "Create your own center" goes to its /signup.
MAIN_SITE_URL=

# Ops alerts (optional, free): your own Telegram chat id. With TELEGRAM_BOT_TOKEN set, server errors, failed
# jobs and a missing nightly backup are sent there. Get the id: write to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id.
OPS_TELEGRAM_CHAT_ID=
