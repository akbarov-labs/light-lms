# --- lms-light configuration (copy to .env; every value has a safe local default) ---

# Postgres connection. Inside Docker Compose the host is "db"; for `npm run dev` use localhost:${DB_PORT}.
DATABASE_URL=postgresql://lms:lms@localhost:5433/lms?schema=public

# Secret used to sign login sessions (JWT). Generate one: `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the web app (used in Telegram messages, receipts and Payme return links).
APP_URL=http://localhost:3000

# Optional. Telegram bot token from @BotFather. Empty = bot disabled, worker still runs jobs.
TELEGRAM_BOT_TOKEN=

# true = on first start, fill an empty database with the demo center (logins in README).
SEED_DEMO=true

# Platform (super) admins: comma-separated staff phones that may open /platform (all centers,
# plans, disable a center). Empty = nobody. Example for the demo owner: 998901234567
PLATFORM_ADMIN_PHONES=

# Timezone for all jobs and "today" calculations.
TZ=Asia/Tashkent

# Host ports Docker Compose publishes (change if something else already uses them).
WEB_PORT=3000
DB_PORT=5433

# Public demo (optional). On the main site set DEMO_URL to the demo server's /demo link (e.g. https://demo.example.uz/demo)
# so the landing page shows "See the demo". On a separate demo server set DEMO_MODE=true (+ SEED_DEMO=true):
# /demo signs visitors in as the demo owner, passwords/staff/center settings are locked, and the worker wipes and
# re-seeds the database every night at 04:00. NEVER set DEMO_MODE=true on a server with real centers.
DEMO_MODE=false
DEMO_URL=
# On the demo server: the main site's address, so "Create your own center" goes to its /signup.
MAIN_SITE_URL=
